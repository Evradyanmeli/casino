# Local development. Prisma reads this file; npm run dev/start/db:seed load it too.
# Example format: postgresql://USER:PASSWORD@localhost:5432/casinox
DATABASE_URL=
# Generate each secret separately: openssl rand -hex 32
JWT_SECRET=
COOKIE_SECRET=
CORS_ORIGIN=http://localhost:5173
PORT=3000
NODE_ENV=development
# Optional demo seed, only on an isolated development database.
# Choose independent private passwords of at least 12 characters.
SEED_ADMIN_PASSWORD=
SEED_PLAYER_PASSWORD=
