{
  "name": "casinox-backend",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "engines": { "node": ">=22.13" },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/app.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/app.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "node --env-file-if-exists=.env --import tsx src/seed.ts",
    "test": "vitest",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/jwt": "^10.2.0",
    "@fastify/rate-limit": "^11.1.0",
    "@prisma/client": "^5.0.0",
    "bcryptjs": "^2.4.3",
    "dayjs": "^1.11.0",
    "fastify": "^5.0.0",
    "fastify-plugin": "^4.0.0",
    "ioredis": "^5.0.0",
    "socket.io": "^4.0.0",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "@eslint/js": "^9.39.5",
    "typescript-eslint": "^8.0.0",
    "@types/bcryptjs": "^2.4.0",
    "@types/node": "^20.0.0",
    "prisma": "^5.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  }
}
